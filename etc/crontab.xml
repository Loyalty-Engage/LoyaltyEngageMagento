<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="loyalty_cart_expiry" instance="LoyaltyEngage\LoyaltyShop\Cron\CartExpiry"
            method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>

        <job name="loyaltyshop_deliver_events" instance="LoyaltyEngage\LoyaltyShop\Cron\DeliverEvents" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="loyaltyshop_recover_mutations" instance="LoyaltyEngage\LoyaltyShop\Cron\RecoverMutations" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
    </group>
</config>
