<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="loyalty_settings" translate="label" sortOrder="100">
            <label>Loyalty Engage</label>
        </tab>
        <section id="loyalty" translate="label" type="text" sortOrder="110"
            showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Loyalty</label>
            <tab>loyalty_settings</tab>
            <resource>LoyaltyEngage_LoyaltyShop::config</resource>

            <group id="enrollment" translate="label" sortOrder="95" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Checkout Loyalty Enrollment</label>
                <field id="mode" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enrollment Mode</label>
                    <source_model>LoyaltyEngage\LoyaltyShop\Model\Config\Source\EnrollmentMode</source_model>
                    <comment>Disabled by default. Opt-in mode hides wallet access until synced loyalty fields exist or an opt-in event is delivered. Wallet earning continues. Loyalty Engage controls acceptance of other events.</comment>
                </field>
                <field id="label" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Checkbox Text</label>
                    <comment>Plain text. The checkbox is never preselected for a new cart. Customers save their preference; opt-in is sent when the order is placed.</comment>
                </field>
            </group>
            <group id="general" translate="label" type="text" sortOrder="10"
                showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Loyalty Cart Configuration</label>

                <field id="module_enable" translate="label" type="select" sortOrder="5"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Loyalty Engage Module</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Set to 'Yes' to enable the Loyalty Engage module functionality.</comment>
                </field>

                <field id="loyalty_api_url" translate="label" type="text" sortOrder="10"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Loyalty Api Url</label>
                    <validate>required-entry validate-url</validate>
                    <comment>Please ensure the URL starts with "https://".</comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="tenant_id" translate="label" type="obscure" sortOrder="20"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Client Id</label>
                    <validate>required-entry</validate>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>This value is stored encrypted in the database.</comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="bearer_token" translate="label" type="obscure" sortOrder="30"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Client Secret</label>
                    <validate>required-entry</validate>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>This value is stored encrypted in the database.</comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="cart_expiry_time" translate="label" type="select" sortOrder="40"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Cart Expiry Time</label>
                    <source_model>LoyaltyEngage\LoyaltyShop\Model\Config\Source\CartExpiryOptions</source_model>
                    <comment>select dropdown value for cart expiry.</comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="logger_enable" translate="label" type="select" sortOrder="50"
                    showInDefault="1"
                    showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Logger Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="debug_logging" translate="label" type="select" sortOrder="55"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Debug Logging</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enable detailed debug logging for troubleshooting loyalty product detection issues.</comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="loyalty_order_place_retrieve" translate="label" type="text"
                    sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1"
                    canRestore="1">
                    <label>Loyalty Order Retrieve Limit</label>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="max_loyalty_products" translate="label comment" type="text" sortOrder="85"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Max Loyalty Products in Cart</label>
                    <validate>validate-digits validate-zero-or-greater</validate>
                    <comment><![CDATA[Maximum number of different loyalty products a customer can add to the cart. Set to 0 for unlimited.]]></comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="minimum_order_value" translate="label comment" type="text" sortOrder="90"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Minimum Order Value for Loyalty Products</label>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <comment><![CDATA[Minimum cart subtotal (excluding loyalty products) required before customers can add loyalty products. Set to 0 to disable this restriction.]]></comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="minimum_order_value_message" translate="label comment" type="textarea" sortOrder="91"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Minimum Order Value Error Message</label>
                    <comment><![CDATA[Custom error message when minimum order value is not met. Use {{minimum}} for the minimum value and {{current}} for the current cart subtotal. Example: "Your cart must have at least €{{minimum}} to add loyalty products. Current: €{{current}}"]]></comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="minimum_order_value_bar_color" translate="label comment" type="text" sortOrder="92"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Minimum Order Value Message Bar Color</label>
                    <validate>validate-color</validate>
                    <comment><![CDATA[Background color for the error message bar. Use hex color code (e.g., #ff0000 for red, #ffc107 for warning yellow). Default: #e74c3c]]></comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="minimum_order_value_text_color" translate="label comment" type="text" sortOrder="93"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Minimum Order Value Message Text Color</label>
                    <validate>validate-color</validate>
                    <comment><![CDATA[Text color for the error message. Use hex color code (e.g., #ffffff for white). Default: #ffffff]]></comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="loyalty_product_removed_message" translate="label comment" type="textarea" sortOrder="94"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Loyalty Product Removed Message</label>
                    <comment><![CDATA[Message shown when loyalty products are automatically removed because the cart total drops below the minimum. Use {{minimum}} for the minimum value and {{current}} for the current cart subtotal. Example: "Your loyalty product(s) have been removed because your cart total dropped below €{{minimum}}. Current total: €{{current}}"]]></comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>
            </group>
            <group id="export" translate="label" type="text" sortOrder="15"
                showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Loyalty Export Settings</label>
            
                 <field id="return_event" translate="label" type="select" sortOrder="10"
                    showInDefault="1"
                    showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Return Export</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                 <field id="purchase_event" translate="label" type="select" sortOrder="20"
                    showInDefault="1"
                    showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Purchase Export</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="event_price_includes_tax" translate="label comment" type="select" sortOrder="22"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Purchase and Return Price Tax Basis</label>
                    <source_model>LoyaltyEngage\LoyaltyShop\Model\Config\Source\EventPriceTax</source_model>
                    <comment><![CDATA[Default: Excluding Tax. Applies to product unit prices in new Purchase and Return events, using the order store configuration and stored tax-inclusive prices. Does not change discount handling or already queued events. Coordinate changes with Loyalty Engage: older purchases may have used a different tax basis.]]></comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                 <field id="purchase_order_status" translate="label comment" type="multiselect" sortOrder="25"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Purchase Sync Order Status</label>
                    <source_model>LoyaltyEngage\LoyaltyShop\Model\Config\Source\OrderStatuses</source_model>
                    <comment><![CDATA[The order statuses that trigger the purchase sync to LoyaltyEngage. All statuses available in this Magento environment are shown. An order is exported only once, even when it passes through multiple selected statuses. Default: Complete.]]></comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                        <field id="loyalty/export/purchase_event">1</field>
                    </depends>
                </field>

                <field id="exclude_tier_priced_items" translate="label comment" type="select" sortOrder="24"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Exclude Applied Tier Prices from Purchase Export</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[Default: No. For new orders created from a Magento quote, exclude only order lines whose price is reduced by a quantity tier above 1. Having tier prices configured is not enough. The decision is saved when the order is placed and also used for returns. Other order lines are exported normally. This does not block coupons or loyalty redemptions at checkout and does not change existing orders.]]></comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                        <field id="loyalty/export/purchase_event">1</field>
                    </depends>
                </field>

                <field id="allowed_order_sources" translate="label comment" type="multiselect" sortOrder="26"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Order Event Export Sources</label>
                    <source_model>LoyaltyEngage\LoyaltyShop\Model\Config\Source\OrderSources</source_model>
                    <comment><![CDATA[Only orders created through the selected sources are exported. Keep all sources selected to preserve the default behavior. API includes REST, SOAP and GraphQL.]]></comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="excluded_order_comment_markers" translate="label comment" type="textarea" sortOrder="27"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Order Event Excluded Comment Markers</label>
                    <comment><![CDATA[Optional. Enter one case-insensitive text fragment per line. Orders containing a matching status-history comment are not exported.]]></comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                 <field id="review_event" translate="label" type="select" sortOrder="30"
                    showInDefault="1"
                    showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Review Export</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Export customer reviews to LoyaltyEngage when submitted.</comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>
            </group>
            <group id="shipping" translate="label" type="text" sortOrder="20"
                showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Loyalty Tier Free Shipping</label>
            
                 <field id="free_shipping_enable" translate="label" type="select" sortOrder="10"
                    showInDefault="1"
                    showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Free Shipping for Loyalty Tiers</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Automatically apply free shipping for customers with qualifying loyalty tiers.</comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                 <field id="free_shipping_tiers" translate="label" type="text" sortOrder="20"
                    showInDefault="1"
                    showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Free Shipping Tiers</label>
                    <comment>Enter tier names separated by semicolons (e.g., Bronze;Silver;Gold). Case sensitive.</comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                        <field id="loyalty/shipping/free_shipping_enable">1</field>
                    </depends>
                </field>

                 <field id="tier_cache_duration" translate="label" type="text" sortOrder="30"
                    showInDefault="1"
                    showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Tier Cache Duration (seconds)</label>
                    <validate>validate-digits</validate>
                    <comment>How long to cache customer tier information. Default: 600 seconds (10 minutes).</comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                        <field id="loyalty/shipping/free_shipping_enable">1</field>
                    </depends>
                </field>
            </group>
            <group id="wallet" translate="label comment" type="text" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Wallet</label>
                <comment>Personal EUR wallet. Enable only after payment and refund acceptance on your staging environment.</comment>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Wallet</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Disabled by default. New logged-in customer orders only, EUR base and order currency, per store. Credit becomes available at status complete. Existing financial corrections continue after disabling.</comment>
                </field>
                <field id="name" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Wallet Name</label>
                </field>
                <field id="spending_enabled" translate="label comment" type="select" sortOrder="21" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Wallet Payment</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Logged-in own-cart checkout only, EUR, single shipping address. Full wallet payment requires Zero Subtotal Checkout. Disabled by default.</comment>
                </field>
                <field id="payment_methods" translate="label comment" type="multiselect" sortOrder="22" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Wallet-Compatible Payment Methods</label>
                    <source_model>Magento\Payment\Model\Config\Source\Allmethods</source_model>
                    <comment>Only allow methods after verifying mixed-tender capture and partial refunds in staging. Zero Subtotal Checkout must be allowed for full wallet payments.</comment>
                </field>
                <field id="rates" translate="label comment" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Earn Percentage per Tier</label>
                    <frontend_model>LoyaltyEngage\LoyaltyShop\Block\Adminhtml\Form\Field\WalletRates</frontend_model>
                    <backend_model>LoyaltyEngage\LoyaltyShop\Model\Config\Backend\WalletRates</backend_model>
                    <comment>Use the exact store-scoped le_current_tier value, e.g. base: 1, gold: 2. Unknown tiers earn nothing. After discounts; shipping excluded. Policy is fixed at order placement.</comment>
                </field>
                <field id="including_tax" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Include Merchandise Tax in Earn Basis</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="coins_required" translate="label comment" type="select" sortOrder="49" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Debit Loyalty Engage Coins for Wallet Payments</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Disabled by default. Whole euros only. Confirmed purchases survive failed payments without a second coin debit. Returns forfeit spent credit. Configure all four SKUs first.</comment>
                </field>
                <field id="redemption_sku_1" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>EUR 1 Discount Product SKU</label>
                    <backend_model>LoyaltyEngage\LoyaltyShop\Model\Config\Backend\WalletRedemptionSku</backend_model>
                    <comment>Loyalty Engage discount product SKU, not a Magento SKU or coupon code. Configure four distinct dedicated wallet products without a reusable checkout discount.</comment>
                </field>
                <field id="redemption_sku_5" translate="label" type="text" sortOrder="51" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>EUR 5 Discount Product SKU</label>
                    <backend_model>LoyaltyEngage\LoyaltyShop\Model\Config\Backend\WalletRedemptionSku</backend_model>
                </field>
                <field id="redemption_sku_10" translate="label" type="text" sortOrder="52" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>EUR 10 Discount Product SKU</label>
                    <backend_model>LoyaltyEngage\LoyaltyShop\Model\Config\Backend\WalletRedemptionSku</backend_model>
                </field>
                <field id="redemption_sku_50" translate="label" type="text" sortOrder="53" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>EUR 50 Discount Product SKU</label>
                    <backend_model>LoyaltyEngage\LoyaltyShop\Model\Config\Backend\WalletRedemptionSku</backend_model>
                </field>
            </group>
            <group id="personalizations" translate="label" type="text" sortOrder="30"
                showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Frontend Personalizations</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Frontend Personalizations</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Disabled by default. Uses the official Loyalty Engage frontend loader, independently of API credentials.</comment>
                </field>
                <field id="tenant_id" translate="label comment" type="textarea" sortOrder="20"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Frontend Tenant UUID or Loader Snippet</label>
                    <backend_model>LoyaltyEngage\LoyaltyShop\Model\Config\Backend\PersonalizationTenant</backend_model>
                    <comment><![CDATA[Paste the UUID or the official empty &lt;script type="module" async src="https://le-cloud.app/f/t/UUID.js"&gt;&lt;/script&gt;. Only the UUID is stored. This is not the API Client ID. Add this exact storefront domain in Loyalty Engage > Developer > Frontend settings > Allowed domains; configure staging separately.]]></comment>
                </field>
                <field id="currency" translate="label comment" type="text" sortOrder="30"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Loyalty Engage Organization Currency</label>
                    <backend_model>LoyaltyEngage\LoyaltyShop\Model\Config\Backend\PersonalizationCurrency</backend_model>
                    <validate>validate-alpha</validate>
                    <comment>Three uppercase letters, for example EUR. Amounts are omitted if this is missing or a Magento exchange rate is unavailable. Product unit price and cart product subtotal follow Purchase/Return tax basis, before coupon discounts and excluding shipping.</comment>
                </field>
                <field id="rules" translate="label comment" type="text" sortOrder="40"
                    showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Personalization Rules</label>
                    <frontend_model>LoyaltyEngage\LoyaltyShop\Block\Adminhtml\Form\Field\Personalizations</frontend_model>
                    <backend_model>LoyaltyEngage\LoyaltyShop\Model\Config\Backend\PersonalizationRules</backend_model>
                    <comment><![CDATA[Manual placement: insert the Loyalty Engage Personalization widget in a CMS/Page Builder Text element, or use {{widget type="LoyaltyEngage\LoyaltyShop\Block\Widget\Personalization" key="your-key"}}. Keys are unique lowercase names. Automatic rules appear before page content. Selected paths are comma-separated, for example /membership,/about-us (include any store URL prefix). Configure replace content in Loyalty Engage for value updates. No scripts are stored in these rows.]]></comment>
                </field>
                <field id="debug" translate="label comment" type="select" sortOrder="50"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Frontend Personalization Debug Logging</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Browser console diagnostics for rule keys, target availability, loader state and context changes. Identifiers, balances, tokens and API responses are never logged.</comment>
                </field>
            </group>
            <group id="frontend" translate="label" type="text" sortOrder="25"
                showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Frontend Loyalty Data</label>

                <field id="expose_customer_meta" translate="label" type="select" sortOrder="10"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Expose Loyalty Meta In Frontend</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Expose store-scoped loyalty fields in customer section data, on the account dashboard, and in the Loyalty Meta widget for PageBuilder/JS consumers.</comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                    </depends>
                </field>

                <field id="account_block_title" translate="label" type="text" sortOrder="20"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Account Block Title</label>
                    <comment>Title shown above the loyalty data block on the customer account page.</comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                        <field id="loyalty/frontend/expose_customer_meta">1</field>
                    </depends>
                </field>

                <field id="account_navigation_label" translate="label" type="text" sortOrder="21"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Account Navigation Label</label>
                    <comment>Label shown in the customer account navigation tab for the loyalty page.</comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                        <field id="loyalty/frontend/expose_customer_meta">1</field>
                    </depends>
                </field>

                <field id="account_navigation_sort_order" translate="label comment" type="text" sortOrder="22"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Account Navigation Position</label>
                    <validate>validate-digits</validate>
                    <comment>Higher numbers appear higher in the customer account navigation. Example: 155.</comment>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                        <field id="loyalty/frontend/expose_customer_meta">1</field>
                    </depends>
                </field>

                <field id="le_current_tier_enabled" translate="label" type="select" sortOrder="30"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Show Current Loyalty Tier</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="loyalty/general/module_enable">1</field>
                        <field id="loyalty/frontend/expose_customer_meta">1</field>
                    </depends>
                </field>
