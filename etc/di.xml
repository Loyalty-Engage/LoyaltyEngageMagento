<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="loyalty_events" xsi:type="object">LoyaltyEngage\LoyaltyShop\Console\EventsCommand</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Sales\Model\ResourceModel\Order\Relation">
        <plugin name="loyaltyshop_wallet_order_snapshot" type="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\OrderRelation" sortOrder="100"/>
    </type>
    <type name="Magento\Quote\Model\QuoteManagement">
        <plugin name="loyaltyshop_minimum_submit" type="LoyaltyEngage\LoyaltyShop\Plugin\MinimumOrderSubmitPlugin"/>
        <plugin name="loyaltyshop_wallet_submit" type="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\Submit" sortOrder="200"/>
    </type>
    <type name="Magento\Sales\Model\Order\Invoice">
        <plugin name="loyaltyshop_wallet_invoice_actions" type="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\InvoiceActions"/>
    </type>
    <type name="Magento\Sales\Model\Service\CreditmemoService">
        <plugin name="loyaltyshop_wallet_refund_actions" type="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\RefundActions"/>
    </type>
    <type name="Magento\Sales\Model\Order\Creditmemo">
        <plugin name="loyaltyshop_wallet_zero_refund" type="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\RefundActions"/>
    </type>
    <type name="Magento\Sales\Model\Order">
        <plugin name="loyaltyshop_wallet_order_actions" type="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\OrderActions"/>
    </type>
    <type name="Magento\Sales\Block\Order\Totals">
        <plugin name="loyaltyshop_wallet_sales_totals" type="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\SalesTotals"/>
    </type>
    <type name="Magento\Sales\Model\InvoiceOrder">
        <plugin name="loyaltyshop_wallet_invoice_api" type="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\DocumentApi"/>
    </type>
    <type name="Magento\Sales\Model\RefundOrder">
        <plugin name="loyaltyshop_wallet_refund_order_api" type="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\DocumentApi"/>
    </type>
    <type name="Magento\Sales\Model\RefundInvoice">
        <plugin name="loyaltyshop_wallet_refund_invoice_api" type="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\DocumentApi"/>
    </type>
    <type name="Magento\Sales\Model\Order\Validation\CanRefund">
        <plugin name="loyaltyshop_wallet_refund_order_validation" type="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\RefundValidation"/>
    </type>
    <type name="Magento\Sales\Model\Order\Invoice\Validation\CanRefund">
        <plugin name="loyaltyshop_wallet_refund_invoice_validation" type="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\RefundValidation"/>
    </type>
    <type name="LoyaltyEngage\LoyaltyShop\Model\Wallet\Guard">
        <arguments><argument name="locks" xsi:type="object">LoyaltyEngage\LoyaltyShop\Model\Wallet\DatabaseLocks</argument></arguments>
    </type>
    <type name="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\Submit">
        <arguments><argument name="locks" xsi:type="object">LoyaltyEngage\LoyaltyShop\Model\Wallet\DatabaseLocks</argument></arguments>
    </type>
    <type name="LoyaltyEngage\LoyaltyShop\Controller\Wallet\Apply">
        <arguments><argument name="locks" xsi:type="object">LoyaltyEngage\LoyaltyShop\Model\Wallet\DatabaseLocks</argument></arguments>
    </type>
    <type name="LoyaltyEngage\LoyaltyShop\Cron\WalletHolds">
        <arguments><argument name="locks" xsi:type="object">LoyaltyEngage\LoyaltyShop\Model\Wallet\DatabaseLocks</argument></arguments>
    </type>
    <preference for="LoyaltyEngage\LoyaltyShop\Api\LoyaltyCartInterface"
        type="LoyaltyEngage\LoyaltyShop\Model\LoyaltyCart" />
    <preference for="LoyaltyEngage\LoyaltyShop\Api\Data\LoyaltyCartResponseInterface"
        type="LoyaltyEngage\LoyaltyShop\Model\LoyaltyCartResponse" />
    <preference for="LoyaltyEngage\LoyaltyShop\Api\LoyaltyCartItemsRemoveApiInterface"
        type="LoyaltyEngage\LoyaltyShop\Model\LoyaltyCartItemsRemoveAll" />
    <preference for="LoyaltyEngage\LoyaltyShop\Api\LoyaltyCartItemRemoveApiInterface"
        type="LoyaltyEngage\LoyaltyShop\Model\LoyaltyCartItemRemove" />
    <preference for="LoyaltyEngage\LoyaltyShop\Api\CustomerLoyaltyInterface"
        type="LoyaltyEngage\LoyaltyShop\Model\CustomerLoyalty" />
    <preference for="LoyaltyEngage\LoyaltyShop\Api\Data\CustomerLoyaltyUpdateResponseInterface"
        type="LoyaltyEngage\LoyaltyShop\Model\Data\CustomerLoyaltyUpdateResponse" />
    <preference for="LoyaltyEngage\LoyaltyShop\Api\Data\LoyaltyCartItemInterface"
        type="LoyaltyEngage\LoyaltyShop\Model\LoyaltyCartItem" />
    <type name="Magento\Customer\CustomerData\Customer">
        <plugin name="loyaltyshop_customer_data_plugin"
            type="LoyaltyEngage\LoyaltyShop\Plugin\CustomerDataPlugin" />
    </type>
    
    <type name="Magento\Checkout\Block\Cart\Item\Renderer">
        <plugin name="loyaltyshop_cart_item_renderer_plugin"
            type="LoyaltyEngage\LoyaltyShop\Plugin\CheckoutCartItemRendererPlugin"
            sortOrder="100" />
    </type>
    
    <type name="Magento\CatalogInventory\Model\Quote\Item\QuantityValidator">
        <plugin name="loyaltyshop_quote_item_qty_validator_plugin"
            type="LoyaltyEngage\LoyaltyShop\Plugin\QuoteItemQtyValidatorPlugin" />
    </type>
    
    <type name="Magento\Checkout\Controller\Cart\UpdatePost">
        <plugin name="loyaltyshop_cart_update_plugin"
            type="LoyaltyEngage\LoyaltyShop\Plugin\CartUpdatePlugin"
            sortOrder="10" />
    </type>
    
    <type name="Magento\Quote\Model\Quote">
        <plugin name="loyaltyshop_minimum_totals" type="LoyaltyEngage\LoyaltyShop\Plugin\MinimumOrderTotalsPlugin" sortOrder="100"/>
        <plugin name="loyaltyshop_quote_remove_item_plugin"
            type="LoyaltyEngage\LoyaltyShop\Plugin\QuoteRemoveItemPlugin"
            sortOrder="10" />
    </type>
    
    <type name="Magento\Quote\Model\Quote\Address">
        <plugin name="loyaltyshop_address_shipping" type="LoyaltyEngage\LoyaltyShop\Plugin\Quote\AddressPlugin" sortOrder="100"/>
    </type>
    <type name="Magento\Quote\Model\Quote\Item\ToOrderItem">
        <plugin name="loyaltyshop_item_marker" type="LoyaltyEngage\LoyaltyShop\Plugin\ConvertLoyaltyItemPlugin"/>
        <plugin name="loyaltyshop_tier_price_snapshot" type="LoyaltyEngage\LoyaltyShop\Plugin\CaptureTierPriceExclusionPlugin" sortOrder="20"/>
    </type>
    <type name="Magento\Framework\MessageQueue\PublisherInterface">
        <plugin name="loyaltyshop_durable_publish" type="LoyaltyEngage\LoyaltyShop\Plugin\DurablePublisherPlugin"/>
    </type>
    <type name="LoyaltyEngage\LoyaltyShop\Service\AbstractConsumer">
        <plugin name="loyaltyshop_legacy_consumer" type="LoyaltyEngage\LoyaltyShop\Plugin\LegacyConsumerPlugin"/>
    </type>
    <type name="LoyaltyEngage\LoyaltyShop\Cron\DeliverEvents">
        <arguments>
            <argument name="consumers" xsi:type="array">
                <item name="loyaltyshop.purchase_event" xsi:type="object">LoyaltyEngage\LoyaltyShop\Model\Queue\PurchaseConsumer</item>
                <item name="loyaltyshop.return_event" xsi:type="object">LoyaltyEngage\LoyaltyShop\Model\Queue\ReturnConsumer</item>
                <item name="loyaltyshop.review_event" xsi:type="object">LoyaltyEngage\LoyaltyShop\Model\Queue\ReviewConsumer</item>
                <item name="loyaltyshop.free_product_purchase_event" xsi:type="object">LoyaltyEngage\LoyaltyShop\Model\Queue\FreeProductPurchaseConsumer</item>
                <item name="loyaltyshop.free_product_remove_event" xsi:type="object">LoyaltyEngage\LoyaltyShop\Model\Queue\FreeProductRemoveConsumer</item>
                <item name="loyaltyshop.redeem_discount_event" xsi:type="object">LoyaltyEngage\LoyaltyShop\Model\Queue\RedeemDiscountConsumer</item>
                <item name="loyaltyshop.claim_discount_event" xsi:type="object">LoyaltyEngage\LoyaltyShop\Model\Queue\ClaimDiscountConsumer</item>
            </argument>
        </arguments>
    </type>
    
    <!-- Add loyalty conditions to cart price rules -->
    <type name="Magento\SalesRule\Model\Rule\Condition\Combine">
        <plugin name="loyaltyshop_sales_rule_condition_plugin"
            type="LoyaltyEngage\LoyaltyShop\Plugin\SalesRule\Model\Rule\Condition\CombinePlugin"
            sortOrder="100" />
    </type>
    
    <!-- REST API Authentication Plugin - validates Basic Auth for LoyaltyEngage endpoints -->
    <type name="Magento\Framework\Webapi\Authorization">
        <plugin name="loyaltyshop_webapi_authentication_plugin"
            type="LoyaltyEngage\LoyaltyShop\Plugin\WebApi\AuthenticationPlugin"
            sortOrder="10" />
    </type>

    <!-- Custom Logger -->
    <type name="LoyaltyEngage\LoyaltyShop\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">loyaltyshop</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">LoyaltyEngage\LoyaltyShop\Logger\Handler</item>
            </argument>
        </arguments>
    </type>

    <!-- Inject handler -->
    <type name="LoyaltyEngage\LoyaltyShop\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
            <argument name="fileName" xsi:type="string">/var/log/loyaltyshop.log</argument>
        </arguments>
    </type>

    <type name="Magento\SalesRule\Model\Utility">
        <plugin name="loyaltyshop_wallet_internal_coupon" type="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\InternalCoupon"/>
    </type>
    <!-- Coupon Post Plugin Frontend -->
    <type name="Magento\Checkout\Controller\Cart\CouponPost">
        <plugin name="loyaltyengage_coupon_plugin"
                type="LoyaltyEngage\LoyaltyShop\Plugin\CouponPostPlugin"
                sortOrder="10"/>
    </type>

    <!-- Coupon Management Plugin API -->
    <type name="Magento\Quote\Model\CouponManagement">
        <plugin name="loyaltyengage_coupon_api_plugin"
                type="LoyaltyEngage\LoyaltyShop\Plugin\CouponManagementPlugin"
                sortOrder="10"/>
    </type>
    <type name="Magento\Checkout\Model\ShippingInformationManagement">
        <plugin name="loyaltyshop_wallet_shipping_totals" type="LoyaltyEngage\LoyaltyShop\Plugin\Wallet\ShippingInformation"/>
    </type>
</config>
