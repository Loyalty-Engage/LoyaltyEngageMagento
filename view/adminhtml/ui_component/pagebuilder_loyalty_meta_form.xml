<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd"
      extends="pagebuilder_base_form">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">pagebuilder_loyalty_meta_form.pagebuilder_loyalty_meta_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Loyalty Meta</item>
    </argument>
    <settings>
        <deps>
            <dep>pagebuilder_loyalty_meta_form.pagebuilder_loyalty_meta_form_data_source</dep>
        </deps>
        <namespace>pagebuilder_loyalty_meta_form</namespace>
    </settings>
    <dataSource name="pagebuilder_loyalty_meta_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_PageBuilder/js/form/provider</item>
            </item>
        </argument>
        <dataProvider name="pagebuilder_loyalty_meta_form_data_source" class="Magento\PageBuilder\Model\ContentType\DataProvider">
            <settings>
                <requestFieldName/>
                <primaryFieldName/>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="20">
        <settings>
            <label translate="true">General</label>
            <collapsible>false</collapsible>
            <opened>true</opened>
        </settings>
        <field name="title" sortOrder="10" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">page</item>
                    <item name="default" xsi:type="string">Loyalty Overview</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Titel</label>
                <dataType>text</dataType>
                <dataScope>title</dataScope>
            </settings>
        </field>
        <field name="empty_message" sortOrder="20" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">page</item>
                    <item name="default" xsi:type="string">Log in om je loyalty gegevens te bekijken.</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Lege status tekst</label>
                <dataType>text</dataType>
                <dataScope>empty_message</dataScope>
                <notice translate="true">Wordt getoond als er nog geen loyalty data beschikbaar is voor de bezoeker.</notice>
            </settings>
        </field>
    </fieldset>
</form>
