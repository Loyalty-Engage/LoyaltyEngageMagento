    <h2 class="le-panel__title" id="loyalty-wallet-payment-title"><?= $block->escapeHtml($wallet['name']) ?></h2>
    <p class="le-panel__intro"><?= $block->escapeHtml(__('Available credit: EUR %1', $wallet['available'])) ?></p>
    <?php if ($wallet['coins_required']): ?>
        <p><?= $block->escapeHtml(__('Whole euros only. Loyalty coins are spent when placing the order. Purchased credit is retained if payment fails; spent credit and coins are not returned on a refund.')) ?></p>
    <?php endif; ?>
    <form class="le-wallet__form" action="<?= $block->escapeUrl($block->getUrl('loyalty/wallet/apply', ['_nosid' => true])) ?>" method="post">
        <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($wallet['form_key']) ?>">
