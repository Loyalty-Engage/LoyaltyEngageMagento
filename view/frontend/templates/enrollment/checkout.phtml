<?php
/** @var \LoyaltyEngage\LoyaltyShop\Block\Enrollment\Checkout $block */
$settings = $block->settings();
if (!$settings) { return; }
?>
<div class="block loyalty-enrollment" data-loyalty-enrollment
     data-url="<?= $block->escapeUrl($settings['url']) ?>"
     data-form-key="<?= $block->escapeHtmlAttr($settings['form_key']) ?>"
     data-quote-token="<?= $block->escapeHtmlAttr($settings['quote_token']) ?>">
    <div class="field choice">
        <input class="checkbox" id="loyalty-enrollment" type="checkbox" data-loyalty-choice <?= $settings['selected'] ? 'checked' : '' ?>>
        <label class="label" for="loyalty-enrollment"><?= $block->escapeHtml($settings['label']) ?></label>
    </div>
    <?php if ($settings['advisory']): ?>
        <p><?= $block->escapeHtml(__('You participate in the loyalty program regardless of this choice.')) ?></p>
    <?php endif; ?>
    <p role="alert" data-loyalty-error hidden><?= $block->escapeHtml(__('Your loyalty preference could not be saved. Refresh checkout and try again.')) ?></p>
</div>
