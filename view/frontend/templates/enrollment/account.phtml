<?php
/** @var \LoyaltyEngage\LoyaltyShop\Block\Enrollment\Customer $block */
$label = $block->getEnrollmentLabel();
if ($label === '' || !($status = $block->getEnrollmentStatus())) { return; }
?>
<section class="le-panel" aria-labelledby="loyalty-account-enrollment-title">
    <h2 class="le-panel__title" id="loyalty-account-enrollment-title"><?= $block->escapeHtml(__('Loyalty enrollment')) ?></h2>
    <div class="block-content">
        <?php if ($status === 'not_enrolled'): ?>
            <form method="post" action="<?= $block->escapeUrl($block->getUrl('loyalty/enrollment/join', ['_secure' => true])) ?>">
                <?= $block->getBlockHtml('formkey') ?>
                <div class="field choice">
                    <input class="checkbox" type="checkbox" id="loyalty-account-opt-in" name="loyalty_opt_in" value="1" required>
                    <label class="label" for="loyalty-account-opt-in"><?= $block->escapeHtml($label) ?></label>
                </div>
                <button class="action primary btn btn-primary le-panel__button" type="submit"><?= $block->escapeHtml(__('Join loyalty program')) ?></button>
            </form>
        <?php else: ?>
            <p><?= $block->escapeHtml(match ($status) {
                'member' => __('You are enrolled in the loyalty program.'),
                'failed' => __('Your loyalty enrollment could not be processed. Please contact the shop.'),
                default => __('Your loyalty enrollment is being processed.'),
            }) ?></p>
        <?php endif; ?>
    </div>
</section>
