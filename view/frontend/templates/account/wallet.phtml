<?php
/** @var \LoyaltyEngage\LoyaltyShop\Block\Account\Wallet $block */
$details = $block->details();
if (!$details) {
    return;
}
?>
<section class="loyaltyshop-wallet le-panel" aria-labelledby="loyalty-wallet-balance-title">
    <h2 class="le-panel__title" id="loyalty-wallet-balance-title"><?= $block->escapeHtml(__('Wallet balance')) ?></h2>
    <dl class="le-wallet__summary">
        <div>
            <dt><?= $block->escapeHtml(__('Available credit')) ?></dt>
            <dd><?= $block->escapeHtml(__('EUR %1', $details['available'])) ?></dd>
        </div>
        <div>
            <dt><?= $block->escapeHtml(__('Reserved for orders')) ?></dt>
            <dd class="le-wallet__reserved"><?= $block->escapeHtml(__('EUR %1', $details['reserved'])) ?></dd>
        </div>
    </dl>
    <div>
        <?php if ($details['negative']): ?>
            <p class="le-wallet__note"><?= $block->escapeHtml(__('Accounting balance: EUR %1. Future earnings offset prior return corrections.', $details['balance'])) ?></p>
        <?php endif; ?>
        <?php if (!$details['spending']): ?>
            <p class="le-wallet__note"><?= $block->escapeHtml(__('Wallet payment is currently disabled by the shop.')) ?></p>
        <?php endif; ?>
    </div>
    <div class="le-wallet__history">
        <h2 class="le-panel__title" id="loyalty-wallet-history-title"><?= $block->escapeHtml(__('Recent wallet transactions')) ?></h2>
        <?php if ($details['history']): ?>
            <div class="le-wallet__transactions" role="region" aria-labelledby="loyalty-wallet-history-title" tabindex="0">
                <table class="data table" aria-labelledby="loyalty-wallet-history-title">
                    <thead><tr>
                        <th scope="col"><?= $block->escapeHtml(__('Date (UTC)')) ?></th>
                        <th scope="col"><?= $block->escapeHtml(__('Transaction')) ?></th>
                        <th scope="col"><?= $block->escapeHtml(__('Amount (EUR)')) ?></th>
                    </tr></thead>
                    <tbody>
                    <?php foreach ($details['history'] as $row): ?>
                        <tr>
                            <td><?= $block->escapeHtml($row['created_at']) ?></td>
                            <td><?= $block->escapeHtml(match ($row['kind']) {
                                'order_accrual' => __('Order credit'),
                                'order_payment' => __('Order payment'),
                                'payment_refund' => __('Payment returned to wallet'),
                                'payment_release' => __('Unused order credit returned'),
                                default => __('Return / cancellation correction'),
                            }) ?></td>
                            <td><?= $block->escapeHtml($row['amount']) ?></td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php else: ?>
            <p><?= $block->escapeHtml(__('No wallet transactions yet.')) ?></p>
        <?php endif; ?>
    </div>
</section>
