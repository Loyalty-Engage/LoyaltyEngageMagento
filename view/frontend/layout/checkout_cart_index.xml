<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body><referenceContainer name="content">
        <block class="LoyaltyEngage\LoyaltyShop\Block\Wallet\Checkout" name="loyaltyshop.wallet.payment" before="-" template="LoyaltyEngage_LoyaltyShop::wallet/checkout.phtml"/>
    </referenceContainer>
        <referenceBlock name="checkout.cart.totals">
            <block name="loyalty_wallet" template="LoyaltyEngage_LoyaltyShop::wallet/hyva-cart-total.phtml"/>
            <arguments><argument name="jsLayout" xsi:type="array"><item name="components" xsi:type="array"><item name="block-totals" xsi:type="array"><item name="children" xsi:type="array">
                <item name="loyalty_wallet" xsi:type="array"><item name="component" xsi:type="string">LoyaltyEngage_LoyaltyShop/js/view/wallet-total</item><item name="sortOrder" xsi:type="number">50</item></item>
            </item></item></item></argument></arguments>
        </referenceBlock>
    </body>
</page>
