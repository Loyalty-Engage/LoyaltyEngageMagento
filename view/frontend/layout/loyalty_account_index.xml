<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="2columns-left"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="page.main.title">
            <arguments>
                <argument name="css_class" xsi:type="string">page-title</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="LoyaltyEngage\LoyaltyShop\Block\Account\LoyaltyMeta"
                   name="loyaltyshop.customer.account.page"
                   template="LoyaltyEngage_LoyaltyShop::account/loyalty-page.phtml"/>
        </referenceContainer>
    </body>
</page>
